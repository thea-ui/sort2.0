  <diagram name="Change Log" id="PCwqN9OENlE0krpBK7au">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cl-title" value="SORT DFD - Change Log (latest additions)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#00271D;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cl-body" value="&lt;b&gt;Teal = new&lt;/b&gt; | &lt;b&gt;Gold = updated&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 1.0 Submit Campus Report / D1 Reports: reports now include recyclable material tags and the Mixed/Others label, plus a stored points breakdown.&lt;br&gt;2. 5.0 Award Points: writes the rank + material points breakdown back to D1; material bonus rules are configurable by the admin.&lt;br&gt;3. 12.0 Manage Settings: new flow to D4 for Material Point Rules (D4 is now Point History, Rank and Material Rules).&lt;br&gt;4. 6.0 / D7: walk-in turnover now accepts PET bottles, aluminum cans by size, and cardboard weighed in kilograms.&lt;br&gt;5. 10.0 / D10: sales record the price per kilogram at sale time (no fixed market rate); D10 now includes revenue.&lt;br&gt;6. D3 to MRF Staff: live bin map and fill levels read flow.&lt;br&gt;7. New 15.0 Generate Impact and Residual Analytics: reads D1, D7 and D3, and outputs impact, residual and operational analytics to Admin. Residual waste is monitored by volume and pickup activity, not weight.&lt;br&gt;8. Page-3 context diagram: MRF receives Live Bin Map and Fill Levels; the Student report flow now includes materials." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="560" height="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

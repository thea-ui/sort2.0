DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sortv2_db?schema=public"
PORT=5000
# REQUIRED. Minimum 32 chars. The server refuses to boot with a missing/short secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
NODE_ENV="development"
# Optional: comma-separated browser origins allowed to call the API (localhost is always allowed).
CORS_ORIGINS=""
# Reverse-proxy trust for real client IPs (Express `trust proxy`). Use "loopback"
# for a proxy on this machine (default), "1" for one upstream hop, or "true" for all.
TRUST_PROXY="loopback"

# EnrollPro Integration
ENROLLPRO_BASE_URL="https://your-enrollpro-instance.com/api"
ENROLLPRO_SYNC_SECRET="your_integration_key_here"
# Role overrides: comma-separated employeeId=ROLE pairs
ENROLLPRO_ROLE_OVERRIDES="1234503=MRF,1234501=ADMIN"

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sortv2_db?schema=public"

PORT=5000
JWT_SECRET="your_jwt_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
NODE_ENV="development"

# EnrollPro Integration
ENROLLPRO_BASE_URL="https://your-enrollpro-url/api"
ENROLLPRO_SYNC_SECRET="your_sync_secret_here"
ENROLLPRO_ACCOUNT="your_account_id"
ENROLLPRO_PASSWORD="your_password"
ENROLLPRO_DEFAULT_PASSWORD="your_default_password"
ENROLLPRO_ROLE_OVERRIDES="employeeId=ROLE,employeeId=ROLE"
SYNC_INTERVAL_CRON="0 * * * *"

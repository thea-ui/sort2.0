{
  "name": "sortv2-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-walkin": "tsx src/scripts/seed-walk-in-rewards.ts",
    "db:seed-offline": "tsx prisma/seed-offline-students.ts",
    "db:studio": "prisma studio",
    "sync:enrollpro": "tsx src/scripts/bulk-sync.ts",
    "emergency:session": "tsx src/scripts/emergency-session.ts",
    "sync:atlas": "tsx src/scripts/sync-atlas.ts",
    "test:atlas": "node --import tsx --test src/services/__tests__/atlas-map.test.ts",
    "test:branding": "node --import tsx --test src/services/__tests__/branding.test.ts",
    "test:sync-guard": "node --import tsx --test src/services/__tests__/enrollpro-sync-guard.test.ts",
    "db:reset-market": "tsx src/scripts/reset-market-stock.ts",
    "db:wipe-accounts": "tsx prisma/wipe-accounts.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.4.0",
    "prisma-erd-generator": "^3.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

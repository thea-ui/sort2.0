generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  MRF
  ADMIN
}

enum SyncSource {
  LOCAL
  ENROLLPRO
}

enum ReportStatus {
  PENDING
  DISPATCHED
  COLLECTED
  RESOLVED
  DISMISSED
  EXPIRED
}

enum WasteCategory {
  RECYCLABLE
  BIODEGRADABLE
  NON_BIODEGRADABLE
  HAZARDOUS
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum ReportType {
  WASTE
  ASSET
}

enum Severity {
  WARNING
  DEDUCT
  SUSPENSION
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum EventType {
  COLLECTION
  EVENT
  MAINTENANCE
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum ChallengeType {
  REPORT_COUNT
  WEIGHT_COLLECTED
  HAZARDOUS_REPORT
}

enum CertificateType {
  MILESTONE
  RANK
}

enum CertificateTier {
  MILESTONE
  CHAMPION
  LEADER
  ADVOCATE
}

enum RewardType {
  POINTS
  PHYSICAL
}

enum RewardClaimStatus {
  UNLOCKED
  REQUESTED
  RELEASED
  CANCELLED
}

model SchoolYear {
  id            String    @id @default(uuid())
  enrollproId   Int?      @unique @map("enrollpro_id")
  label         String    // "2026-2027"
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  isArchived    Boolean   @default(false) @map("is_archived")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  reports              Report[]
  pointHistories       PointHistory[]
  offenses             Offense[]
  saleTransactions     RecycleSaleTransaction[]
  assetRecords          MrfAssetRecord[]
  assetScrapSaleTransactions AssetScrapSaleTransaction[]
  assetScrapStockSnapshots   AssetScrapStockSnapshot[]
  assetScrapItems            AssetScrapItem[]
  auditLogs            AuditLog[]
  marketStockSnapshots MarketStockSnapshot[]
  pointSnapshots       UserPointSnapshot[]
  walkInTurnovers      WalkInTurnover[]
  rewardClaims         RewardClaim[]

  @@map("school_years")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  employeeId       String   @unique @map("employee_id")
  role             Role     @default(STUDENT)
  points           Int          @default(0)
  warningsCount    Int          @default(0) @map("warnings_count")
  accountStatus    AccountStatus @default(ACTIVE) @map("account_status")
  suspendedUntil   DateTime?    @map("suspended_until")
  classroomSection String?  @map("classroom_section")
  certificates     String[] @default([]) @map("certificates")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // EnrollPro sync fields
  syncSource            SyncSource @default(LOCAL) @map("sync_source")
  enrollproId           String?    @unique @map("enrollpro_id")
  enrollproLrn          String?    @unique @map("enrollpro_lrn")
  gradeLevel            String?    @map("grade_level")
  sectionName           String?    @map("section_name")
  academicProgram       String?    @map("academic_program")
  schoolYearId          Int?       @map("school_year_id")
  schoolYearLabel       String?    @map("school_year_label")
  isTemporarilyEnrolled Boolean?   @default(false) @map("is_temporarily_enrolled")
  enrollmentStatus      String?    @map("enrollment_status")
  portalAccountActive   Boolean?   @default(true) @map("portal_account_active")
  archivedAt            DateTime?  @map("archived_at")

  reports         Report[]       @relation("ReportedBy")
  assignedReports Report[]       @relation("AssignedToMRF")
  offenses        Offense[]
  pointHistories  PointHistory[]
  pointSnapshots  UserPointSnapshot[]
  sessions        UserSession[]
  challengeProgress    UserChallengeProgress[]
  challengeContributions ChallengeContribution[]
  certificatesIssued   Certificate[]
  walkIns              WalkInTurnover[] @relation("WalkInStudent")
  walkInsRecorded      WalkInTurnover[] @relation("WalkInRecorder")
  rewardClaims         RewardClaim[]
  rewardReleases       RewardClaim[]    @relation("RewardReleasedBy")

  @@index([enrollproId])
  @@index([syncSource])
  @@index([role])
  @@index([points])
  @@map("users")
}

model Report {
  id              String        @id @default(uuid())
  title           String
  description     String
  status          ReportStatus  @default(PENDING)
  urgency         Urgency       @default(MEDIUM)
  category        WasteCategory @default(NON_BIODEGRADABLE)
  lat             Float
  lng             Float
  locationName    String        @map("location_name")
  locationKey     String        @map("location_key")
  reporterId      String        @map("reporter_id")
  pointsAwarded   Int           @default(0) @map("points_awarded")
  pointsAwardedAt DateTime?     @map("points_awarded_at")
  imageUrl        String?       @db.Text @map("image_url")
  weightCollected Float?        @map("weight_collected")
  isVerified      Boolean       @default(false) @map("is_verified")
  reportType      ReportType    @default(WASTE) @map("report_type")
  assignedMrfId   String?       @map("assigned_mrf_id")
  reporterRank    Int?          @map("reporter_rank")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  schoolYearId  String?     @map("school_year_id")
  schoolYear    SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  reporter    User  @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedMrf User? @relation("AssignedToMRF", fields: [assignedMrfId], references: [id], onDelete: SetNull)

  pointHistories         PointHistory[]
  challengeContributions ChallengeContribution[]

  @@index([reporterId])
  @@index([status])
  @@index([category])
  @@index([schoolYearId])
  @@index([locationKey, category, schoolYearId])
  @@index([assignedMrfId])
  @@map("reports")
}

model WasteBin {
  id             String        @id @default(uuid())
  name           String
  locationName   String        @map("location_name")
  fillLevel      Int           @default(0) @map("fill_level")
  type           WasteCategory @default(NON_BIODEGRADABLE)
  lat            Float
  lng            Float
  activeDispatch Boolean       @default(false) @map("active_dispatch")
  lastEmptied    DateTime?     @map("last_emptied")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("waste_bins")
}

model Offense {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  description  String
  severity     Severity @default(WARNING)
  expiresAt    DateTime? @map("expires_at")
  schoolYearId String?  @map("school_year_id")
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schoolYearId])
  @@map("offenses")
}

model PointHistory {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  amount       Int
  reason       String
  reportId     String?   @unique @map("report_id")
  challengeId  String?   @map("challenge_id")
  walkInTurnoverId String? @unique @map("walk_in_turnover_id")
  rewardClaimId    String? @unique @map("reward_claim_id")
  schoolYearId String?   @map("school_year_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge?  @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  report     Report?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  walkInTurnover WalkInTurnover? @relation(fields: [walkInTurnoverId], references: [id], onDelete: SetNull)
  rewardClaim    RewardClaim?    @relation(fields: [rewardClaimId], references: [id], onDelete: SetNull)
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolYearId])
  @@index([challengeId])
  @@map("point_histories")
}

model Challenge {
  id            String        @id @default(uuid())
  code          String
  title         String
  description   String
  challengeType ChallengeType @default(REPORT_COUNT) @map("challenge_type")
  pointsAwarded Int           @map("points_awarded")
  target        Int
  isActive      Boolean       @default(true) @map("is_active")
  iconName      String        @map("icon_name")
  // Academic term this challenge instance belongs to. "GLOBAL" = unscoped/legacy.
  quarterCode   String        @default("GLOBAL") @map("quarter_code")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  createdAt     DateTime      @default(now()) @map("created_at")

  progressRecords    UserChallengeProgress[]
  contributions      ChallengeContribution[]
  pointHistories     PointHistory[]

  @@unique([code, quarterCode])
  @@index([quarterCode])
  @@map("challenges")
}

model UserChallengeProgress {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  challengeId  String    @map("challenge_id")
  currentCount Int       @default(0) @map("current_count")
  completedAt  DateTime? @map("completed_at")
  rewardedAt   DateTime? @map("rewarded_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
  @@map("user_challenge_progress")
}

model ChallengeContribution {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  challengeId String   @map("challenge_id")
  reportId    String   @map("report_id")
  value       Float    @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, reportId])
  @@index([challengeId])
  @@index([reportId])
  @@map("challenge_contributions")
}

model SystemSetting {
  id                        String   @id @default("default_setting")
  pointsPerReport           Int      @default(50) @map("points_per_report")
  pointsPerKgRecyclable     Int      @default(10) @map("points_per_kg_recyclable")
  warningThreshold          Int      @default(3) @map("warning_threshold")
  certificatePointThreshold Int      @default(500) @map("certificate_point_threshold")
  certificateGraceDays      Int      @default(3) @map("certificate_grace_days")
  certificateMilestoneName  String   @default("Eco-Milestone Certificate") @map("certificate_milestone_name")
  certificateChampionName   String   @default("Eco-Champion Certificate") @map("certificate_champion_name")
  certificateLeaderName     String   @default("Eco-Leader Certificate") @map("certificate_leader_name")
  certificateAdvocateName   String   @default("Eco-Advocate Certificate") @map("certificate_advocate_name")
  quarterGateActive         Boolean  @default(false) @map("quarter_gate_active")
  smartSyncEnabled          Boolean  @default(true) @map("smart_sync_enabled")
  syncMode                  String   @default("MANUAL") @map("sync_mode")
  syncIntervalMinutes       Int      @default(60) @map("sync_interval_minutes")
  atlasSyncMode             String   @default("AUTO") @map("atlas_sync_mode")
  atlasSyncIntervalMinutes  Int      @default(15) @map("atlas_sync_interval_minutes")
  blueprintPreset           String   @default("DEFAULT") @map("blueprint_preset")
  blueprintUrl              String?  @map("blueprint_url")
  maxUnverifiedReports      Int      @default(3) @map("max_unverified_reports")
  dismissPointPenalty       Int      @default(10) @map("dismiss_point_penalty")
  falseReportPointPenalty   Int      @default(50) @map("false_report_point_penalty")
  warningAutoDeductAmount   Int      @default(10) @map("warning_auto_deduct_amount")
  suspensionDurationHours   Int      @default(24) @map("suspension_duration_hours")
  rewardsReservePercent     Int      @default(20) @map("rewards_reserve_percent")
  defaultVendorName         String   @default("GreenCycle Recycling Vendor") @map("default_vendor_name")
  binResetEnabled           Boolean  @default(true) @map("bin_reset_enabled")
  binResetTime              String   @default("18:00") @map("bin_reset_time")
  walkInPointsPer500ml      Int      @default(1) @map("walk_in_points_per_500ml")
  walkInEnabled             Boolean  @default(true) @map("walk_in_enabled")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  date        String
  type        EventType @default(EVENT)
  description String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("calendar_events")
}

model SyncLog {
  id            String     @id @default(uuid())
  system        String
  status        SyncStatus @default(SUCCESS)
  recordsSynced Int        @default(0) @map("records_synced")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("sync_logs")
}

model AssetCategory {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  presets   ItemPreset[]

  @@map("asset_categories")
}

model ItemPreset {
  id         String        @id @default(uuid())
  categoryId String        @map("category_id")
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("item_presets")
}

model CampusLocation {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("Available")
  x         Float
  y         Float
  streams   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("campus_locations")
}

model RoomLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  building  String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("room_locations")
}

model WasteType {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String
  hexColor    String   @map("hex_color")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("waste_types")
}

model UrgencyLevel {
  id          String   @id @default(uuid())
  level       String
  code        String   @unique
  slaHours    Int      @map("sla_hours")
  description String
  badgeStyle  String   @map("badge_style")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("urgency_levels")
}

model AssetCondition {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String
  badgeStyle  String   @map("badge_style")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("asset_conditions")
}

model PointRule {
  id            String   @id @default(uuid())
  rank          Int      @unique
  title         String
  pointsAwarded Int      @map("points_awarded")
  description   String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("point_rules")
}

model AcademicQuarter {
  id          String   @id @default(uuid())
  quarterName String   @map("quarter_name")
  quarterCode String   @unique @map("quarter_code")
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("academic_quarters")
}

model RecycleMarketStock {
  id                String    @id @default(uuid())
  categoryCode      String    @unique @map("category_code")
  categoryName      String    @map("category_name")
  shortName         String    @map("short_name")
  thresholdLimitKg  Float     @map("threshold_limit_kg")
  marketPricePerKg  Float     @map("market_price_per_kg")
  accumulatedKg     Float     @default(0.0) @map("accumulated_kg")
  isApprovedForSale Boolean   @default(false) @map("is_approved_for_sale")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("recycle_market_stocks")
}

model RecycleSaleTransaction {
  id            String   @id @default(uuid())
  categoryCode  String   @map("category_code")
  categoryName  String   @map("category_name")
  weightKg      Float    @map("weight_kg")
  marketPriceKg Float    @map("market_price_kg")
  totalRevenue  Float    @map("total_revenue")
  buyerName     String   @map("buyer_name")
  schoolYearId  String?  @map("school_year_id")
  schoolYear    SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  soldAt        DateTime @default(now()) @map("sold_at")

  @@index([schoolYearId])
  @@map("recycle_sale_transactions")
}

// ─── EnrollPro Sync Models ────────────────────────────────────────────

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model TermCalendar {
  id              String   @id @default(uuid())
  enrollproId     Int      @unique @map("enrollpro_id")
  termName        String   @map("term_name")
  termCode        String   @map("term_code")
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  schoolYearId    Int      @map("school_year_id")
  schoolYearLabel String   @map("school_year_label")
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([schoolYearId])
  @@map("term_calendars")
}

model EnrollmentSyncLog {
  id              String     @id @default(uuid())
  syncType        String     @map("sync_type")
  status          SyncStatus @default(SUCCESS)
  recordsPulled   Int        @default(0) @map("records_pulled")
  recordsCreated  Int        @default(0) @map("records_created")
  recordsUpdated  Int        @default(0) @map("records_updated")
  recordsDeleted  Int        @default(0) @map("records_deleted")
  errorMessage    String?    @map("error_message")
  message         String?    @map("message")
  schoolYearId    Int?       @map("school_year_id")
  schoolYearLabel String?    @map("school_year_label")
  durationMs      Int?       @map("duration_ms")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("enrollment_sync_logs")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorName    String   @map("actor_name")
  actorRole    String   @map("actor_role")
  actionType   String   @map("action_type")
  details      String
  ipAddress    String?  @map("ip_address")
  schoolYearId String?  @map("school_year_id")
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actionType])
  @@index([schoolYearId])
  @@map("audit_logs")
}

model CampusNews {
  id          String   @id @default(uuid())
  title       String
  body        String
  tag         String
  tagColor    String   @map("tag_color")
  iconColor   String   @map("icon_color")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([createdAt])
  @@map("campus_news")
}

// ─── School Year Snapshot Models ─────────────────────────────────────

model MarketStockSnapshot {
  id            String   @id @default(uuid())
  schoolYearId  String   @map("school_year_id")
  schoolYear    SchoolYear @relation(fields: [schoolYearId], references: [id])
  categoryCode  String   @map("category_code")
  categoryName  String   @map("category_name")
  closingKg     Float    @map("closing_kg")
  openingKg     Float    @default(0) @map("opening_kg")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([schoolYearId, categoryCode])
  @@map("market_stock_snapshots")
}

model UserPointSnapshot {
  id            String   @id @default(uuid())
  schoolYearId  String   @map("school_year_id")
  schoolYear    SchoolYear @relation(fields: [schoolYearId], references: [id])
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  closingPoints Int      @map("closing_points")
  rank          Int?
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([schoolYearId, userId])
  @@map("user_point_snapshots")
}

model MrfAssetRecord {
  id             String      @id @default(uuid())
  assetName      String      @map("asset_name")
  category       String      // Furniture, Electronics, Fixtures, Equipment, Other
  action         String      // RECOVERED, REPAIRED, DISPOSED
  disposition    String?     // Specific outcome label, e.g. "Repaired at MRF Workshop"
  quantity       Float       @default(1)
  unit           String      @default("pcs")
  condition      String?     // GOOD, FAIR, NEEDS_REPAIR, DISPOSED
  sourceReportId String?     @map("source_report_id")
  locationName   String?     @map("location_name")
  notes          String?
  performedBy    String?     @map("performed_by")
  schoolYearId   String?     @map("school_year_id")
  schoolYear     SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([schoolYearId])
  @@index([action])
  @@index([sourceReportId])
  @@map("mrf_asset_records")
}

// ─── Asset Scrap Recovery Stock (unserviceable assets weighed & sold by material) ───

model AssetScrapStock {
  id                String    @id @default(uuid())
  materialCode      String    @unique @map("material_code")
  materialName      String    @map("material_name")
  thresholdLimitKg  Float     @map("threshold_limit_kg")
  marketPricePerKg  Float     @map("market_price_per_kg")
  accumulatedKg     Float     @default(0.0) @map("accumulated_kg")
  isApprovedForSale Boolean   @default(false) @map("is_approved_for_sale")
  approvalReference String?   @map("approval_reference")
  approvedAt        DateTime? @map("approved_at")
  hazmat            Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("asset_scrap_stocks")
}

// Per-item scrap records. An item enters as AWAITING_WEIGHT when an asset is
// declared unserviceable but cannot be weighed yet (mirrors the residual
// "unweighed batch" concept), then moves IN_STOCK once weighed, SOLD when its
// batch is sold, or DISPOSED when routed to an accredited handler.
model AssetScrapItem {
  id                String    @id @default(uuid())
  materialCode      String    @map("material_code")
  materialName      String    @map("material_name")
  weightKg          Float?    @map("weight_kg")
  status            String    @default("AWAITING_WEIGHT")
  description       String?
  sourceAssetId     String?   @map("source_asset_id")
  sourceReportId    String?   @map("source_report_id")
  weighedBy         String?   @map("weighed_by")
  weighedAt         DateTime? @map("weighed_at")
  saleTransactionId String?   @map("sale_transaction_id")
  disposedBy        String?   @map("disposed_by")
  disposedAt        DateTime? @map("disposed_at")
  disposalReference String?   @map("disposal_reference")
  schoolYearId      String?   @map("school_year_id")
  schoolYear        SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([materialCode])
  @@index([status])
  @@index([sourceAssetId])
  @@index([sourceReportId])
  @@index([schoolYearId])
  @@map("asset_scrap_items")
}

model AssetScrapSaleTransaction {
  id                String   @id @default(uuid())
  materialCode      String   @map("material_code")
  materialName      String   @map("material_name")
  weightKg          Float    @map("weight_kg")
  marketPriceKg     Float    @map("market_price_kg")
  totalRevenue      Float    @map("total_revenue")
  buyerName         String   @map("buyer_name")
  approvalReference String?  @map("approval_reference")
  schoolYearId      String?  @map("school_year_id")
  schoolYear        SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  soldAt            DateTime @default(now()) @map("sold_at")

  @@index([schoolYearId])
  @@map("asset_scrap_sale_transactions")
}

model AssetScrapStockSnapshot {
  id           String   @id @default(uuid())
  schoolYearId String   @map("school_year_id")
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  materialCode String   @map("material_code")
  materialName String   @map("material_name")
  closingKg    Float    @map("closing_kg")
  openingKg    Float    @default(0) @map("opening_kg")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([schoolYearId, materialCode])
  @@map("asset_scrap_stock_snapshots")
}

// ─── Certificate Issuance ─────────────────────────────────────────────

model Certificate {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serial          String          @unique
  type            CertificateType
  tier            CertificateTier
  name            String
  rankAtIssue     Int?            @map("rank_at_issue")
  pointsAtIssue   Int             @map("points_at_issue")
  termCode        String?         @map("term_code")
  termName        String?         @map("term_name")
  schoolYearId    String?         @map("school_year_id")
  schoolYearLabel String?         @map("school_year_label")
  issuedAt        DateTime        @default(now()) @map("issued_at")
  issuedBy        String?         @map("issued_by")
  templateVersion String          @default("v1") @map("template_version")

  @@index([userId])
  @@index([schoolYearId, termCode])
  @@index([type])
  @@map("certificates")
}

// ─── ATLAS Campus Map Mirror ──────────────────────────────────────────

model AtlasMapSnapshot {
  id              String    @id @default(uuid())
  schoolId        Int       @unique @map("school_id")
  etag            String?
  contentHash     String    @map("content_hash")
  buildingCount   Int       @default(0) @map("building_count")
  roomCount       Int       @default(0) @map("room_count")
  campusImageUrl  String?   @map("campus_image_url")
  campusImagePath String?   @map("campus_image_path")
  campusImageHash String?   @map("campus_image_hash")
  fetchedAt       DateTime  @default(now()) @map("fetched_at")
  changedAt       DateTime? @map("changed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("atlas_map_snapshots")
}

model AtlasBuilding {
  id                 String    @id @default(uuid())
  atlasId            Int       @unique @map("atlas_id")
  schoolId           Int       @map("school_id")
  name               String
  shortCode          String?   @map("short_code")
  x                  Float
  y                  Float
  width              Float
  height             Float
  color              String?
  rotation           Float     @default(0)
  floorCount         Int       @default(1) @map("floor_count")
  isTeachingBuilding Boolean   @default(true) @map("is_teaching_building")
  gradeScope         Json?
  isActive           Boolean   @default(true) @map("is_active")
  atlasUpdatedAt     DateTime? @map("atlas_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  rooms AtlasRoom[]

  @@index([schoolId, isActive])
  @@map("atlas_buildings")
}

model AtlasRoom {
  id               String        @id @default(uuid())
  atlasId          Int           @unique @map("atlas_id")
  atlasBuildingId  String        @map("atlas_building_id")
  building         AtlasBuilding @relation(fields: [atlasBuildingId], references: [id], onDelete: Cascade)
  name             String
  floor            Int           @default(1)
  type             String
  capacity         Int?
  isTeachingSpace  Boolean       @default(false) @map("is_teaching_space")
  isSharedFacility Boolean       @default(false) @map("is_shared_facility")
  floorPosition    Int?          @map("floor_position")
  features         Json?
  isActive         Boolean       @default(true) @map("is_active")
  atlasUpdatedAt   DateTime?     @map("atlas_updated_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([atlasBuildingId, isActive])
  @@map("atlas_rooms")
}

model AtlasSyncLog {
  id            String     @id @default(uuid())
  schoolId      Int        @map("school_id")
  status        SyncStatus
  unchanged     Boolean    @default(false)
  buildingsSeen Int        @default(0) @map("buildings_seen")
  roomsSeen     Int        @default(0) @map("rooms_seen")
  inserted      Int        @default(0)
  updated       Int        @default(0)
  deactivated   Int        @default(0)
  imageChanged  Boolean    @default(false) @map("image_changed")
  errorMessage  String?    @map("error_message")
  durationMs    Int        @map("duration_ms")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@map("atlas_sync_logs")
}

// ─── Walk-in Bottle Turnovers & Prize Claims ──────────────────────────

model WalkInTurnover {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  recordedById   String?  @map("recorded_by_id")
  recordedByName String   @map("recorded_by_name")
  totalMl        Int      @map("total_ml")
  totalBottles   Int      @map("total_bottles")
  totalGrams     Int      @map("total_grams")
  pointsAwarded  Int      @map("points_awarded")
  ratePer500ml   Int      @map("rate_per_500ml")
  notes          String?
  idempotencyKey String   @unique @map("idempotency_key")
  schoolYearId   String   @map("school_year_id")
  createdAt      DateTime @default(now()) @map("created_at")

  student      User                 @relation("WalkInStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy   User?                @relation("WalkInRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  schoolYear   SchoolYear           @relation(fields: [schoolYearId], references: [id])
  items        WalkInTurnoverItem[]
  pointHistory PointHistory?
  rewardClaims RewardClaim[]

  @@index([studentId, schoolYearId])
  @@index([studentId, createdAt])
  @@index([recordedById])
  @@index([createdAt])
  @@map("walk_in_turnovers")
}

model WalkInTurnoverItem {
  id         String   @id @default(uuid())
  turnoverId String   @map("turnover_id")
  bottleMl   Int      @map("bottle_ml")
  quantity   Int
  grams      Int
  createdAt  DateTime @default(now()) @map("created_at")

  turnover WalkInTurnover @relation(fields: [turnoverId], references: [id], onDelete: Cascade)

  @@index([turnoverId])
  @@map("walk_in_turnover_items")
}

model Reward {
  id            String     @id @default(uuid())
  code          String     @unique
  title         String
  description   String
  iconName      String     @map("icon_name")
  rewardType    RewardType @default(PHYSICAL) @map("reward_type")
  requiredGrams Int        @map("required_grams")
  pointsValue   Int        @default(0) @map("points_value")
  stock         Int?
  isActive      Boolean    @default(true) @map("is_active")
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  claims RewardClaim[]

  @@index([isActive, requiredGrams])
  @@map("rewards")
}

model RewardClaim {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  rewardId      String            @map("reward_id")
  turnoverId    String?           @map("turnover_id")
  status        RewardClaimStatus @default(UNLOCKED)
  claimCode     String            @unique @map("claim_code")
  gramsAtUnlock Int               @map("grams_at_unlock")
  unlockedAt    DateTime          @default(now()) @map("unlocked_at")
  requestedAt   DateTime?         @map("requested_at")
  releasedAt    DateTime?         @map("released_at")
  releasedById  String?           @map("released_by_id")
  schoolYearId  String            @map("school_year_id")
  notes         String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward          @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  turnover   WalkInTurnover? @relation(fields: [turnoverId], references: [id], onDelete: SetNull)
  releasedBy User?           @relation("RewardReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  schoolYear SchoolYear      @relation(fields: [schoolYearId], references: [id])
  pointHistory PointHistory?

  @@unique([userId, rewardId, schoolYearId])
  @@index([status, unlockedAt])
  @@index([userId])
  @@index([rewardId])
  @@map("reward_claims")
}

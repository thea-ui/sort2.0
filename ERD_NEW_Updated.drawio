        <UserObject label="" mermaidData="{&quot;data&quot;:&quot;erDiagram\n    %% LEGEND: -- enforced FK | .. logical/unenforced link | ? nullable\n\n    %% ─────────────────────── ENFORCED FKs ───────────────────────\n    school_years ||--o{ walk_in_turnovers : academic_cycle\n    school_years ||--o{ reward_claims : claim_period\n    school_years ||--o{ market_stock_snapshots : closing_year\n    school_years ||--o{ user_point_snapshots : rollover_year\n    school_years ||--o{ asset_scrap_stock_snapshots : stock_snapshot_period\n    school_years |o--o{ reports : academic_period\n    school_years |o--o{ offenses : fiscal_period\n    school_years |o--o{ point_histories : academic_year\n    school_years |o--o{ challenges : challenge_year\n    school_years |o--o{ recycle_sale_transactions : fiscal_cycle\n    school_years |o--o{ audit_logs : fiscal_audit\n    school_years |o--o{ mrf_asset_records : asset_period\n    school_years |o--o{ asset_scrap_items : scrap_period\n    school_years |o--o{ asset_scrap_sale_transactions : sale_period\n\n    users ||--o{ reports : submits\n    users |o--o{ reports : assigned_mrf\n    users ||--o{ offenses : incurred_by\n    users ||--o{ point_histories : credited_to\n    users ||--o{ user_challenge_progress : tracks_progress\n    users ||--o{ challenge_contributions : contributor\n    users ||--o{ user_sessions : authenticated_as\n    users ||--o{ certificates : issued_to\n    users ||--o{ user_point_snapshots : user_ledger\n    users ||--o{ walk_in_turnovers : submits_bottles\n    users |o--o{ walk_in_turnovers : recorded_by\n    users ||--o{ reward_claims : claimed_by\n    users |o--o{ reward_claims : authorized_release_by\n\n    challenges ||--o{ user_challenge_progress : challenge_target\n    challenges ||--o{ challenge_contributions : challenge_ref\n    challenges |o--o{ point_histories : challenge_award\n    reports |o--o| point_histories : report_award\n    reports ||--o{ challenge_contributions : source_incident\n    walk_in_turnovers |o--o| point_histories : turnover_credit\n    walk_in_turnovers ||--o{ walk_in_turnover_items : contains_items\n    walk_in_turnovers |o--o{ reward_claims : unlocked_by_turnover\n    reward_claims |o--o| point_histories : reward_disbursement\n    rewards ||--o{ reward_claims : reward_tier\n    asset_categories ||--o{ item_presets : category_group\n    atlas_buildings ||--o{ atlas_rooms : located_in\n\n    %% ─────────────────── LOGICAL LINKS (no FK in DB) ───────────────────\n    school_years |o..o{ users : \&quot;school_year_id to enrollpro_id (Int)\&quot;\n    school_years |o..o{ term_calendars : \&quot;school_year_id to enrollpro_id (Int)\&quot;\n    school_years |o..o{ enrollment_sync_logs : \&quot;school_year_id to enrollpro_id (Int)\&quot;\n    school_years |o..o{ certificates : \&quot;school_year_id\&quot;\n    reports |o..o{ mrf_asset_records : \&quot;source_report_id\&quot;\n    reports |o..o{ asset_scrap_items : \&quot;source_report_id\&quot;\n    mrf_asset_records |o..o{ asset_scrap_items : \&quot;source_asset_id\&quot;\n    asset_scrap_sale_transactions |o..o{ asset_scrap_items : \&quot;sale_transaction_id\&quot;\n    asset_scrap_stocks |o..o{ asset_scrap_items : \&quot;material_code\&quot;\n    asset_scrap_stocks |o..o{ asset_scrap_sale_transactions : \&quot;material_code\&quot;\n    asset_scrap_stocks |o..o{ asset_scrap_stock_snapshots : \&quot;material_code\&quot;\n    recycle_market_stocks |o..o{ recycle_sale_transactions : \&quot;category_code\&quot;\n    recycle_market_stocks |o..o{ market_stock_snapshots : \&quot;category_code\&quot;\n    academic_quarters |o..o{ challenges : \&quot;quarter_code (GLOBAL = unscoped)\&quot;\n    atlas_map_snapshots |o..o{ atlas_buildings : \&quot;school_id (external)\&quot;\n    atlas_map_snapshots |o..o{ atlas_sync_logs : \&quot;school_id (external)\&quot;\n    waste_types |o..o{ reports : \&quot;category = code (value lookup)\&quot;\n    urgency_levels |o..o{ reports : \&quot;urgency = code (value lookup)\&quot;\n\n    %% ─────────────────────────── ENTITIES ───────────────────────────\n    school_years {\n        string id PK\n        int? enrollpro_id UK\n        string label\n        datetime start_date\n        datetime end_date\n        boolean is_active\n        boolean is_archived\n        datetime? archived_at\n        datetime created_at\n    }\n\n    users {\n        string id PK\n        string name\n        string email UK\n        string? password_hash\n        string employee_id UK\n        string role\n        int points\n        int warnings_count\n        string account_status\n        datetime? suspended_until\n        string? classroom_section\n        string[] certificates\n        datetime created_at\n        datetime updated_at\n        string sync_source\n        string? enrollpro_id UK\n        string? enrollpro_lrn UK\n        string? grade_level\n        string? section_name\n        string? academic_program\n        int? school_year_id \&quot;logical to school_years.enrollpro_id\&quot;\n        string? school_year_label\n        boolean? is_temporarily_enrolled\n        string? enrollment_status\n        boolean? portal_account_active\n        datetime? archived_at\n        datetime? password_cached_at\n        datetime? password_verified_at\n        boolean password_change_required\n        boolean password_reset_required\n    }\n\n    reports {\n        string id PK\n        string title\n        string description\n        string status\n        string urgency\n        string category\n        float lat\n        float lng\n        string location_name\n        string location_key \&quot;normalized name, not campus_locations.code\&quot;\n        string reporter_id FK\n        int points_awarded\n        int rank_points_awarded\n        int material_points_awarded\n        json? material_points_breakdown\n        datetime? points_awarded_at\n        string? image_url\n        string? photo_path\n        float? weight_collected\n        boolean is_verified\n        string report_type\n        string? assigned_mrf_id FK\n        int? reporter_rank\n        datetime? completed_at\n        string[] materials\n        string? other_material_label\n        string? school_year_id FK\n        datetime created_at\n        datetime updated_at\n    }\n\n    waste_bins {\n        string id PK\n        string name\n        string location_name\n        int fill_level\n        string type\n        float lat\n        float lng\n        boolean active_dispatch\n        datetime? last_emptied\n        datetime created_at\n        datetime updated_at\n    }\n\n    offenses {\n        string id PK\n        string user_id FK\n        string description\n        string severity\n        datetime? expires_at\n        string? school_year_id FK\n        datetime created_at\n    }\n\n    point_histories {\n        string id PK\n        string user_id FK\n        int amount\n        string reason\n        string? report_id UK, FK\n        string? challenge_id FK\n        string? walk_in_turnover_id UK, FK\n        string? reward_claim_id UK, FK\n        string? school_year_id FK\n        datetime created_at\n    }\n\n    challenges {\n        string id PK\n        string code \&quot;unique with quarter_code\&quot;\n        string title\n        string description\n        string challenge_type\n        int points_awarded\n        int target\n        boolean is_active\n        string icon_name\n        string quarter_code \&quot;logical to academic_quarters\&quot;\n        string? school_year_id FK\n        datetime? start_date\n        datetime? end_date\n        datetime created_at\n    }\n\n    user_challenge_progress {\n        string id PK\n        string user_id FK \&quot;unique with challenge_id\&quot;\n        string challenge_id FK\n        int current_count\n        datetime? completed_at\n        datetime? rewarded_at\n        datetime created_at\n        datetime updated_at\n    }\n\n    challenge_contributions {\n        string id PK\n        string user_id FK \&quot;unique with challenge_id + report_id\&quot;\n        string challenge_id FK\n        string report_id FK\n        float value\n        datetime created_at\n    }\n\n    system_settings {\n        string id PK \&quot;singleton: default_setting\&quot;\n        int points_per_report\n        int points_per_kg_recyclable\n        int warning_threshold\n        int certificate_point_threshold\n        int certificate_grace_days\n        string certificate_milestone_name\n        string certificate_champion_name\n        string certificate_leader_name\n        string certificate_advocate_name\n        boolean quarter_gate_active\n        boolean smart_sync_enabled\n        string sync_mode\n        int sync_interval_minutes\n        string atlas_sync_mode\n        int atlas_sync_interval_minutes\n        string blueprint_preset\n        string? blueprint_url\n        int max_unverified_reports\n        int dismiss_point_penalty\n        int false_report_point_penalty\n        int warning_auto_deduct_amount\n        int suspension_duration_hours\n        int rewards_reserve_percent\n        string default_vendor_name\n        boolean bin_reset_enabled\n        string bin_reset_time\n        int walk_in_points_per_500ml\n        boolean walk_in_enabled\n        string school_name\n        string? school_acronym\n        string? school_id \&quot;external, no FK\&quot;\n        string? division\n        string? region\n        string? address\n        string? school_head_name\n        string primary_color\n        string secondary_color\n        string accent_color\n        string gold_color\n        string? logo_url\n        string? enrollpro_public_url\n        string? enrollpro_url\n        datetime? enrollpro_branding_synced_at\n        boolean offline_auth_cache_enabled\n        int offline_auth_cache_max_days\n        datetime updated_at\n    }\n\n    calendar_events {\n        string id PK\n        string title\n        string date\n        string type\n        string description\n        datetime created_at\n    }\n\n    sync_logs {\n        string id PK\n        string system\n        string status\n        int records_synced\n        datetime created_at\n    }\n\n    asset_categories {\n        string id PK\n        string name\n        string code UK\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    item_presets {\n        string id PK\n        string category_id FK\n        string name\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    campus_locations {\n        string id PK\n        string code UK\n        string name\n        string status\n        float x\n        float y\n        json streams \&quot;per-stream availability\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    room_locations {\n        string id PK\n        string name UK\n        string? building\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    waste_types {\n        string id PK\n        string name\n        string code UK\n        string description\n        string hex_color\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    urgency_levels {\n        string id PK\n        string level\n        string code UK\n        int sla_hours\n        string description\n        string badge_style\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    asset_conditions {\n        string id PK\n        string name\n        string code UK\n        string description\n        string badge_style\n        boolean enabled\n        datetime created_at\n        datetime updated_at\n    }\n\n    point_rules {\n        string id PK\n        int rank UK\n        string title\n        int points_awarded\n        string description\n        datetime created_at\n        datetime updated_at\n    }\n\n    academic_quarters {\n        string id PK\n        string quarter_name\n        string quarter_code UK\n        string start_date\n        string end_date\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    recycle_market_stocks {\n        string id PK\n        string category_code UK\n        string category_name\n        string short_name\n        float threshold_limit_kg\n        float market_price_per_kg\n        float accumulated_kg\n        boolean is_approved_for_sale\n        datetime? approved_at\n        string? approval_reference\n        datetime created_at\n        datetime updated_at\n    }\n\n    recycle_sale_transactions {\n        string id PK\n        string category_code \&quot;logical to recycle_market_stocks\&quot;\n        string category_name\n        float weight_kg\n        float market_price_kg\n        float total_revenue\n        string buyer_name\n        string? school_year_id FK\n        datetime sold_at\n    }\n\n    user_sessions {\n        string id PK\n        string user_id FK\n        string refresh_token UK\n        string? device_info\n        string? ip_address\n        datetime expires_at\n        datetime created_at\n    }\n\n    term_calendars {\n        string id PK\n        int enrollpro_id UK\n        string term_name\n        string term_code\n        datetime start_date\n        datetime end_date\n        int school_year_id \&quot;logical to school_years.enrollpro_id\&quot;\n        string school_year_label\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    enrollment_sync_logs {\n        string id PK\n        string sync_type\n        string status\n        int records_pulled\n        int records_created\n        int records_updated\n        int records_deleted\n        string? error_message\n        string? message\n        int? school_year_id \&quot;logical to school_years.enrollpro_id\&quot;\n        string? school_year_label\n        int? duration_ms\n        datetime created_at\n    }\n\n    audit_logs {\n        string id PK\n        string actor_name\n        string actor_role\n        string action_type\n        string details\n        string? ip_address\n        string? school_year_id FK\n        datetime created_at\n    }\n\n    campus_news {\n        string id PK\n        string title\n        string body\n        string tag\n        string tag_color\n        string icon_color\n        boolean is_published\n        datetime created_at\n        datetime updated_at\n    }\n\n    market_stock_snapshots {\n        string id PK\n        string school_year_id FK\n        string category_code \&quot;logical to recycle_market_stocks\&quot;\n        string category_name\n        float closing_kg\n        float opening_kg\n        datetime created_at\n    }\n\n    user_point_snapshots {\n        string id PK\n        string school_year_id FK\n        string user_id FK \&quot;unique with school_year_id\&quot;\n        int closing_points\n        int? rank\n        datetime created_at\n    }\n\n    mrf_asset_records {\n        string id PK\n        string asset_name\n        string category\n        string action \&quot;RECOVERED | REPAIRED | DISPOSED\&quot;\n        string? disposition\n        float quantity\n        string unit\n        string? condition\n        string? source_report_id \&quot;logical to reports.id\&quot;\n        string? location_name\n        string? notes\n        string? performed_by\n        string? school_year_id FK\n        datetime created_at\n    }\n\n    asset_scrap_stocks {\n        string id PK\n        string material_code UK\n        string material_name\n        float threshold_limit_kg\n        float market_price_per_kg\n        float accumulated_kg\n        boolean is_approved_for_sale\n        string? approval_reference\n        datetime? approved_at\n        boolean hazmat\n        datetime created_at\n        datetime updated_at\n    }\n\n    asset_scrap_items {\n        string id PK\n        string material_code \&quot;logical to asset_scrap_stocks\&quot;\n        string material_name\n        float? weight_kg\n        string status \&quot;AWAITING_WEIGHT | IN_STOCK | SOLD | DISPOSED\&quot;\n        string? description\n        string? source_asset_id \&quot;logical to mrf_asset_records.id\&quot;\n        string? source_report_id \&quot;logical to reports.id\&quot;\n        string? weighed_by\n        datetime? weighed_at\n        string? sale_transaction_id \&quot;logical to sale transaction\&quot;\n        string? disposed_by\n        datetime? disposed_at\n        string? disposal_reference\n        string? school_year_id FK\n        datetime created_at\n        datetime updated_at\n    }\n\n    asset_scrap_sale_transactions {\n        string id PK\n        string material_code \&quot;logical to asset_scrap_stocks\&quot;\n        string material_name\n        float weight_kg\n        float market_price_kg\n        float total_revenue\n        string buyer_name\n        string? approval_reference\n        string? school_year_id FK\n        datetime sold_at\n    }\n\n    asset_scrap_stock_snapshots {\n        string id PK\n        string school_year_id FK\n        string material_code \&quot;logical to asset_scrap_stocks, unique with school_year_id\&quot;\n        string material_name\n        float closing_kg\n        float opening_kg\n        datetime created_at\n    }\n\n    certificates {\n        string id PK\n        string user_id FK\n        string serial UK\n        string type\n        string tier\n        string name\n        int? rank_at_issue\n        int points_at_issue\n        string? term_code\n        string? term_name\n        string? school_year_id \&quot;logical to school_years.id\&quot;\n        string? school_year_label\n        datetime issued_at\n        string? issued_by\n        string template_version\n    }\n\n    atlas_map_snapshots {\n        string id PK\n        int school_id UK \&quot;external ATLAS id, no FK\&quot;\n        string? etag\n        string content_hash\n        int building_count\n        int room_count\n        string? campus_image_url\n        string? campus_image_path\n        string? campus_image_hash\n        datetime fetched_at\n        datetime? changed_at\n        datetime created_at\n        datetime updated_at\n    }\n\n    atlas_buildings {\n        string id PK\n        int atlas_id UK\n        int school_id \&quot;external ATLAS id, no FK\&quot;\n        string name\n        string? short_code\n        float x\n        float y\n        float width\n        float height\n        string? color\n        float rotation\n        int floor_count\n        boolean is_teaching_building\n        json? gradeScope\n        boolean is_active\n        datetime? atlas_updated_at\n        datetime created_at\n        datetime updated_at\n    }\n\n    atlas_rooms {\n        string id PK\n        int atlas_id UK\n        string atlas_building_id FK\n        string name\n        int floor\n        string type\n        int? capacity\n        boolean is_teaching_space\n        boolean is_shared_facility\n        int? floor_position\n        json? features\n        boolean is_active\n        datetime? atlas_updated_at\n        datetime created_at\n        datetime updated_at\n    }\n\n    atlas_sync_logs {\n        string id PK\n        int school_id \&quot;external ATLAS id, no FK\&quot;\n        string status\n        boolean unchanged\n        int buildings_seen\n        int rooms_seen\n        int inserted\n        int updated\n        int deactivated\n        boolean image_changed\n        string? error_message\n        int duration_ms\n        datetime created_at\n    }\n\n    walk_in_turnovers {\n        string id PK\n        string student_id FK\n        string? recorded_by_id FK\n        string recorded_by_name\n        string material\n        int total_ml\n        int total_bottles\n        int total_grams\n        int points_awarded\n        int rate_per_500ml\n        string? notes\n        string idempotency_key UK\n        string school_year_id FK\n        datetime created_at\n    }\n\n    walk_in_turnover_items {\n        string id PK\n        string turnover_id FK\n        int bottle_ml\n        int quantity\n        int grams\n        datetime created_at\n    }\n\n    rewards {\n        string id PK\n        string code UK\n        string title\n        string description\n        string icon_name\n        string reward_type\n        int required_grams\n        int points_value\n        int? stock\n        boolean is_active\n        int sort_order\n        datetime created_at\n        datetime updated_at\n    }\n\n    reward_claims {\n        string id PK\n        string user_id FK \&quot;unique with reward_id + school_year_id\&quot;\n        string reward_id FK\n        string? turnover_id FK\n        string status\n        string claim_code UK\n        int grams_at_unlock\n        datetime unlocked_at\n        datetime? requested_at\n        datetime? released_at\n        string? released_by_id FK\n        string school_year_id FK\n        string? notes\n    }\n\n    material_point_rules {\n        string code PK\n        string label\n        int points\n        datetime updated_at\n    }\n\n    rate_limit_counters {\n        string key PK\n        int total_hits\n        datetime reset_at\n    }\n&quot;,&quot;config&quot;:null}" id="BamsTYm06f8WkI5FDNiO-1">
